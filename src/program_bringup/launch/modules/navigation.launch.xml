<?xml version="1.0"?>
<!--
  navigation.launch.xml
  ========================
  Path planning and tracking.
    - global planner : A* on the validated map
    - local planner  : pure pursuit path tracking + integrated VFH avoidance
-->
<launch>

    <!-- ======================= Arguments ======================= -->
    <arg name="use_sim_time" default="true"
         description="Use the simulated (/clock) time source"/>
    <arg name="enable_global_planner" default="true" description="Start the A* global planner"/>
    <arg name="enable_local_planner" default="true" description="Start the pure pursuit local planner"/>

    <!-- global_planners: A* on the validated map -->
    <node pkg="global_planners" exec="a_star" name="a_star" output="screen"
          if="$(var enable_global_planner)">
        <param from="$(find-pkg-share program_bringup)/config/robot_dimensions.yaml"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- local_planners: pure pursuit path tracking + integrated VFH avoidance -->
    <node pkg="local_planners" exec="pure_pursuit" name="pure_pursuit_node" output="screen"
          if="$(var enable_local_planner)">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

</launch>
