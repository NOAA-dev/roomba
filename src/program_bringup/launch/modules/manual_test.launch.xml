<?xml version="1.0"?>
<!-- Keep the relay with the hardware launch; run the interactive client via ros2 run in its own terminal. -->
<launch>
    <arg name="use_sim_time" default="false"/>
    <arg name="robot_dimensions" default="$(find-pkg-share program_bringup)/config/robot_dimensions.yaml"/>

    <node pkg="helpers" exec="cmd_relay" name="cmd_relay" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var robot_dimensions)"/>
    </node>
</launch>
