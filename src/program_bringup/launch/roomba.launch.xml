<launch>

    <include file="$(find-pkg-share program_bringup)/launch/joystick.launch.py"/>
    <include file="$(find-pkg-share program_bringup)/launch/slam.launch.xml"/>

    <let name="urdf_path" value="$(find-pkg-share urdfs)/urdf/roomba.urdf.xacro"/>
    <let name="rviz_config_path" value="$(find-pkg-share urdfs)/rviz/default.rviz"/>
    <let name="gazebo_config_path" value="$(find-pkg-share program_bringup)/config/gazebo_bridge.yaml"/>

    <!-- TF publisher  -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
               value="$(command 'xacro $(var urdf_path)')" />
        <param name="publish_fixed_joints" value="true"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- Gazebo stuff  -->
     <set_env name="GZ_SIM_RESOURCE_PATH"
         value="$(find-pkg-share program_bringup)/models"/> 
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(find-pkg-share program_bringup)/world/small_house.world -r -s" />
    </include>

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description" />

    <!-- Ros-gz bridge  -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var gazebo_config_path)"/>
    </node>

    <!-- rviz starter  -->
    <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config_path)"/>

    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster"/>

    <!-- diff drive controller -->
    <!-- <node pkg="controller_manager" exec="spawner" args="diff_drive_controller controller-ros-args 'ros-args remap ~/cmd_vel:=/cmd_vel'"/> -->

    <!-- simple velocity controller -->
    <node pkg="controller_manager" exec="spawner" args="simple_velocity_controller"/>

    <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node" output="screen">
        <param from="$(find-pkg-share program_bringup)/config/ekf.yaml"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- global_planners: A* on the validated map -->
    <node pkg="global_planners" exec="a_star" name="a_star" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- local_planners: pure pursuit path tracking + integrated VFH avoidance -->
    <node pkg="local_planners" exec="pure_pursuit" name="pure_pursuit_node" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="helpers" exec="map_validator" name="map_validator_" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="helpers" exec="coverage_planner" name="coverage_planner" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="helpers" exec="frontier_explorer" name="frontier_explorer" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="helpers" exec="reactive_explorer" name="object_avoider" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="helpers" exec="manager_node" name="manager_node" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="helpers" exec="data_logger" name="data_logger_node" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

</launch>