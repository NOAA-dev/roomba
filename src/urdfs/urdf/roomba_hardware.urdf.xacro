<?xml version="1.0"?>
<robot name="roomba" xmlns:xacro="https://www.ros.org/wiki/xacro">

    <xacro:arg name="controllers_config_path" default="" />
    <!-- use_sim=true (default) keeps existing Gazebo behavior unchanged.
         use_sim=false switches ros2_hardwareinterface.xacro to the real
         ESP32 hardware plugin (see roomba_hardware package); serial_port/
         baud_rate are only used in that case. -->
    <xacro:arg name="use_sim" default="false" />
    <xacro:arg name="serial_port" default="/dev/roomba_esp32" />
    <xacro:arg name="baud_rate" default="115200" />

    <xacro:include filename="materials.xacro" />
    <xacro:include filename="inertia_descriptions.xacro" />
    <xacro:include filename="ros2_hardwareinterface.xacro" />

    <xacro:roomba_ros2_control
        use_sim="$(arg use_sim)"
        serial_port="$(arg serial_port)"
        baud_rate="$(arg baud_rate)" />

    <xacro:property name="roomba_radius" value="0.1925" />
    <xacro:property name="roomba_height" value="0.1" />
    <xacro:property name="wheel_radius" value="0.035" />
    <xacro:property name="wheel_thickness" value="0.02" />
    
    <link name="roomba">
    </link>
    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="${roomba_radius}" length="${roomba_height}" /> 
            </geometry>
            <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${roomba_radius}" length="${roomba_height}" /> 
            </geometry>
            <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia Mass="10.0" r="${roomba_radius}" h="${roomba_height}" arr_xyz="0 0 ${wheel_radius}" arr_rpy="0 0 0" />
    </link>

    <xacro:macro name="wheel" params="params">
        <link name="${params}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <material name="grey"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </collision>
            <xacro:cylinder_inertia Mass="1.0" r="${wheel_radius}" h="${wheel_thickness}" arr_xyz="0 0 0" arr_rpy="${pi/2} 0 0"/>
        </link>
    </xacro:macro>
    
    <xacro:wheel params="right_wheel" />
    <xacro:wheel params="left_wheel" />


    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.01755"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.01755"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:solid_sphere_inertia Mass="0.5" r="0.01755" arr_xyz="0 0 0" arr_rpy="0 0 0"/> 
    </link>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="-0.05 -0.1665 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="-0.05 0.1665 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="0.1 0 ${-wheel_radius/2}" rpy="0 0 0"/>
    </joint>

    <joint name="spine" type="fixed">
        <parent link="roomba"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>


    <xacro:property name="lidar_radius" value="0.05" />
    <xacro:property name="lidar_height" value="0.05" />

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertia Mass="0.1" r="${lidar_radius}" h="${lidar_height}" arr_xyz="0 0 0" arr_rpy="0 0 0"/>
    </link>

    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="0.1 0 ${0.1 + (lidar_height) / 2.0}" rpy="0 0 0" />
    </joint>

    <link name="lidar_link_optical"/>

    <joint name="lidar_optical_joint" type="fixed">
        <parent link="lidar_link"/>
        <child link="lidar_link_optical"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:property name="imu_length" value="0.01" />
    <xacro:property name="imu_width" value="0.01" />
    <xacro:property name="imu_height" value="0.001" />

    <link name="imu_link">
        <visual>
            <geometry>
                <box size="${imu_length} ${imu_width} ${imu_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${imu_length} ${imu_width} ${imu_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia Mass="0.01" x="${imu_length}" y="${imu_width}" z="${imu_height}" arr_xyz="0 0 0" arr_rpy="0 0 0"/>
    </link>

    <joint name="base_imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <origin xyz="0 0 ${0.1 + (imu_height)}" rpy="0 0 0" />
    </joint>



</robot>