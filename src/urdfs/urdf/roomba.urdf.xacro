<?xml version="1.0"?>
<robot name="roomba" xmlns:xacro="https://www.ros.org/wiki/xacro">

    <xacro:arg name="controllers_config_path" default="" />
    <xacro:arg name="use_sim" default="true" />
    <xacro:arg name="serial_port" default="/dev/roomba_esp32" />
    <xacro:arg name="baud_rate" default="115200" />

    <xacro:include filename="dimensions.xacro" />
    <xacro:include filename="materials.xacro" />
    <xacro:include filename="inertia_descriptions.xacro" />
    <xacro:include filename="camera.xacro" />
    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="imu_sensor.xacro" />
    <xacro:include filename="gazebo_plugin.xacro" />
    <xacro:include filename="ros2_hardwareinterface.xacro" />

    <xacro:roomba_ros2_control
        use_sim="$(arg use_sim)"
        serial_port="$(arg serial_port)"
        baud_rate="$(arg baud_rate)" />

    <link name="roomba">
    </link>
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${footprint_length} ${footprint_width} ${body_height}" />
            </geometry>
            <origin xyz="0 0 ${body_center_z}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${footprint_length} ${footprint_width} ${body_height}" />
            </geometry>
            <origin xyz="0 0 ${body_center_z}" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia Mass="1.0" x="${footprint_length}" y="${footprint_width}" z="${body_height}" arr_xyz="0 0 ${body_center_z}" arr_rpy="0 0 0" />
    </link>

    <xacro:macro name="wheel" params="params">
        <link name="${params}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <material name="grey"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </collision>
            <xacro:cylinder_inertia Mass="0.2" r="${wheel_radius}" h="${wheel_thickness}" arr_xyz="0 0 0" arr_rpy="${pi/2} 0 0"/>
        </link>
    </xacro:macro>
    
    <xacro:wheel params="right_wheel" />
    <xacro:wheel params="left_wheel" />


    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:solid_sphere_inertia Mass="0.1" r="${caster_radius}" arr_xyz="0 0 0" arr_rpy="0 0 0"/> 
    </link>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="${wheel_axle_x} ${-track_width / 2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="${wheel_axle_x} ${track_width / 2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
    </joint>

    <joint name="spine" type="fixed">
        <parent link="roomba"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="caster_wheel">
        <mu1 value="0.01" />
        <mu2 value="0.01" />
    </gazebo>

        <!-- Wheels -->
    <gazebo reference="left_wheel">
        <mu1>1000000000000000.0</mu1>
        <mu2>1000000000000000.0</mu2>
        <kp>1000000000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <gazebo reference="right_wheel">
        <mu1>1000000000000000.0</mu1>
        <mu2>1000000000000000.0</mu2>
        <kp>1000000000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <gazebo>
        <self_collide>false</self_collide>
    </gazebo>

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg controllers_config_path)</parameters>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
        <render_engine>ogre2</render_engine>
        </plugin>
        <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    </gazebo>
    
</robot>