<?xml version="1.0"?>
<robot name="roomba" xmlns:xacro="https://www.ros.org/wiki/xacro">

    <xacro:arg name="controllers_config_path" default="" />

    <xacro:include filename="materials.xacro" />
    <xacro:include filename="inertia_descriptions.xacro" />
    <xacro:include filename="camera.xacro" />
    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="imu_sensor.xacro" />
    <xacro:include filename="gazebo_plugin.xacro" />
    <xacro:include filename="ros2_hardwareinterface.xacro" />

    <xacro:property name="roomba_radius" value="0.2" />
    <xacro:property name="roomba_height" value="0.1" />
    <xacro:property name="wheel_radius" value="0.05" />
    <xacro:property name="wheel_thickness" value="0.03" />
    
    <link name="roomba">
    </link>
    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="${roomba_radius}" length="${roomba_height}" /> 
            </geometry>
            <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${roomba_radius}" length="${roomba_height}" /> 
            </geometry>
            <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia Mass="10.0" r="${roomba_radius}" h="${roomba_height}" arr_xyz="0 0 ${wheel_radius}" arr_rpy="0 0 0" />
    </link>

    <xacro:macro name="wheel" params="params">
        <link name="${params}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <material name="grey"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </collision>
            <xacro:cylinder_inertia Mass="1.0" r="${wheel_radius}" h="${wheel_thickness}" arr_xyz="0 0 0" arr_rpy="${pi/2} 0 0"/>
        </link>
    </xacro:macro>
    
    <xacro:wheel params="right_wheel" />
    <xacro:wheel params="left_wheel" />


    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.025"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:solid_sphere_inertia Mass="0.5" r="0.025" arr_xyz="0 0 0" arr_rpy="0 0 0"/> 
    </link>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="${-roomba_radius/2} ${-roomba_radius/2 - wheel_thickness/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="${-roomba_radius/2} ${roomba_radius/2 + wheel_thickness/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="${roomba_radius/4} 0 ${-wheel_radius/2}" rpy="0 0 0"/>
    </joint>

    <joint name="spine" type="fixed">
        <parent link="roomba"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="caster_wheel">
        <mu1 value="0.01" />
        <mu2 value="0.01" />
    </gazebo>

        <!-- Wheels -->
    <gazebo reference="left_wheel">
        <mu1>1000000000000000.0</mu1>
        <mu2>1000000000000000.0</mu2>
        <kp>1000000000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <gazebo reference="right_wheel">
        <mu1>1000000000000000.0</mu1>
        <mu2>1000000000000000.0</mu2>
        <kp>1000000000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg controllers_config_path)</parameters>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
        <render_engine>ogre2</render_engine>
        </plugin>
        <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    </gazebo>
    
</robot>